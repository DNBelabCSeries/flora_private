{
  "schema_version": 1,
  "id": "single",
  "command": ["flora"],
  "description": "End-to-end single-species workflow contract formerly exposed by run_all.sh.",
  "sources": ["run_all.sh"],
  "positionals": [],
  "options": [
    {"name":"--fastq","aliases":[],"type":"string_list","required":false,"required_when":[],"default":null,"conflicts":["--fastq-dir"],"description":"One or more raw FASTQ inputs for concurrent Glycine processing."},
    {"name":"--fastq-dir","aliases":[],"type":"path","required":false,"required_when":[],"default":null,"conflicts":["--fastq"],"description":"Non-recursive directory containing raw FASTQ chunks."},
    {"name":"--full-length-fastq","aliases":[],"type":"path","required":false,"required_when":[{"option":"--skip-glycine","operator":"equals","value":true}],"default":null,"conflicts":[],"description":"Precomputed full-length FASTQ used when Glycine is skipped."},
    {"name":"--tso-seq","aliases":["--tso_seq"],"type":"string","required":false,"required_when":[],"default":"AAGACCGCTTGGCCTCCGACTTTCTGCG","conflicts":[],"description":"Template-switching oligo sequence."},
    {"name":"--rtp-seq","aliases":["--rtp_seq"],"type":"string","required":false,"required_when":[],"default":"GAGGTCCATGAAGTGAGCATCTTCTGCG","conflicts":[],"description":"Reverse-transcription primer sequence."},
    {"name":"--barcode-list-10bp","aliases":["--barcode_list_10bp"],"type":"path","required":false,"required_when":[],"default":null,"conflicts":[],"description":"10bp barcode list; bundled BC_1536.txt is the fallback."},
    {"name":"--ref-dir","aliases":["--ref_dir"],"type":"path","required":false,"required_when":[],"default":null,"conflicts":[],"description":"Directory supplying conventional reference filenames."},
    {"name":"--gene-fasta","aliases":["--genome-fa"],"type":"path","required":false,"required_when":[{"option":"--ref-dir","operator":"equals","value":null}],"default":null,"conflicts":[],"description":"Genome FASTA for minimap2; overrides ref-dir inference."},
    {"name":"--junction-bed","aliases":[],"type":"path","required":false,"required_when":[{"option":"--ref-dir","operator":"equals","value":null}],"default":null,"conflicts":[],"description":"Junction BED; overrides ref-dir inference."},
    {"name":"--chrom-sizes","aliases":[],"type":"path","required":false,"required_when":[{"option":"--ref-dir","operator":"equals","value":null}],"default":null,"conflicts":[],"description":"Chromosome sizes TSV; overrides ref-dir inference."},
    {"name":"--gene-gtf","aliases":[],"type":"path","required":false,"required_when":[{"option":"--ref-dir","operator":"equals","value":null}],"default":null,"conflicts":[],"description":"Gene GTF; overrides ref-dir inference."},
    {"name":"--isoform-gtf","aliases":[],"type":"path","required":false,"required_when":[],"default":"gene_gtf","conflicts":[],"description":"Isoform GTF; defaults to the resolved gene GTF."},
    {"name":"--out-dir","aliases":["--outdir"],"type":"path","required":true,"required_when":[],"default":null,"conflicts":[],"description":"Workflow output directory."},
    {"name":"--sample-id","aliases":["--sample"],"type":"string","required":false,"required_when":[],"default":"sample","conflicts":[],"description":"Sample identifier."},
    {"name":"--threads","aliases":["--thread"],"type":"int","required":false,"required_when":[],"default":32,"conflicts":[],"description":"Primary worker thread count."},
    {"name":"--cluster-threads","aliases":[],"type":"int","required":false,"required_when":[],"default":16,"conflicts":[],"description":"UMI clustering thread count."},
    {"name":"--glycine-jobs","aliases":[],"type":"int","required":false,"required_when":[],"default":10,"conflicts":[],"description":"Maximum concurrent Glycine jobs."},
    {"name":"--glycine-threads","aliases":[],"type":"int","required":false,"required_when":[],"default":64,"conflicts":[],"description":"Total thread budget shared across Glycine jobs."},
    {"name":"--exp-cells","aliases":[],"type":"int","required":false,"required_when":[],"default":5000,"conflicts":[],"description":"Expected cell count."},
    {"name":"--min-q","aliases":[],"type":"int","required":false,"required_when":[],"default":2,"conflicts":[],"description":"Minimum barcode base quality."},
    {"name":"--max-ed","aliases":[],"type":"int","required":false,"required_when":[],"default":2,"conflicts":[],"description":"Maximum barcode edit distance."},
    {"name":"--barcode-extract-mode","aliases":["--barcode_extract_mode"],"type":"string","required":false,"required_when":[],"default":"fixed_seq","conflicts":[],"description":"Barcode extraction mode; fixed_seq is accepted and probe exits clearly."},
    {"name":"--pair-min","aliases":[],"type":"int","required":false,"required_when":[],"default":null,"conflicts":[],"description":"Fixed pair-support threshold; omission enables automatic resolution."},
    {"name":"--auto-pair-min-floor","aliases":[],"type":"int","required":false,"required_when":[],"default":10,"conflicts":[],"description":"Floor for automatic pair threshold."},
    {"name":"--auto-pair-min-quantile","aliases":[],"type":"float","required":false,"required_when":[],"default":0.1,"conflicts":[],"description":"Quantile for automatic pair threshold."},
    {"name":"--top1-alpha","aliases":[],"type":"float","required":false,"required_when":[],"default":0.1,"conflicts":[],"description":"Read-support top-one alpha."},
    {"name":"--top1-alpha-umi","aliases":[],"type":"float","required":false,"required_when":[],"default":0.3,"conflicts":[],"description":"UMI-support top-one alpha."},
    {"name":"--dominance-min","aliases":[],"type":"float","required":false,"required_when":[],"default":0.8,"conflicts":[],"description":"Minimum dominant component ratio."},
    {"name":"--drop-umiA-ratio-gt","aliases":[],"type":"float","required":false,"required_when":[],"default":0.5,"conflicts":[],"description":"Drop threshold for UMI-A ratio."},
    {"name":"--glycine-outdir","aliases":[],"type":"path","required":false,"required_when":[],"default":"<out-dir>/glycine","conflicts":[],"description":"Glycine output directory."},
    {"name":"--glycine-err","aliases":["--err"],"type":"string","required":false,"required_when":[],"default":"0.2,0.25","conflicts":[],"description":"Glycine end-specific error thresholds."},
    {"name":"--glycine-shift","aliases":["--shift"],"type":"string","required":false,"required_when":[],"default":"200,200","conflicts":[],"description":"Glycine end-specific shift thresholds."},
    {"name":"--min-len","aliases":["--min_len"],"type":"int","required":false,"required_when":[],"default":300,"conflicts":[],"description":"Minimum Glycine read length."},
    {"name":"--umi-len","aliases":["--umi_len"],"type":"int","required":false,"required_when":[],"default":41,"conflicts":[],"description":"Glycine UMI length."},
    {"name":"--skip-glycine","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Skip Glycine and require a full-length FASTQ."},
    {"name":"--skip-isoform","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Skip transcript assignment and isoform matrices."},
    {"name":"--upstream-only","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Stop after barcode, UMI, and cell assignment; last occurrence wins against full-pipeline."},
    {"name":"--full-pipeline","aliases":[],"type":"bool","required":false,"required_when":[],"default":true,"conflicts":[],"description":"Run downstream stages; last occurrence wins against upstream-only."},
    {"name":"--light-output","aliases":[],"type":"bool","required":false,"required_when":[],"default":true,"conflicts":[],"description":"Suppress large intermediate FASTQs; last occurrence wins against full-output."},
    {"name":"--full-output","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Retain all upstream FASTQs; last occurrence wins against light-output."},
    {"name":"--no-revcomp-whitelist","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Disable reverse complementation of whitelist barcodes."},
    {"name":"--save-merge-debug","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Retain barcode merge debug outputs."},
    {"name":"--save-intermediate","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Retain assignment intermediate outputs."},
    {"name":"--remove-final-bam","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Remove all alignment and matrix BAM files after successful report generation."},
    {"name":"--require-pass-both-ends","aliases":[],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Require both barcode ends to pass."},
    {"name":"--gene-assign-mapq","aliases":[],"type":"int","required":false,"required_when":[],"default":30,"conflicts":[],"description":"Minimum gene-assignment MAPQ."},
    {"name":"--gene-assign-chunk-size","aliases":[],"type":"int","required":false,"required_when":[],"default":200000,"conflicts":[],"description":"Gene-assignment chunk size."},
    {"name":"--transcript-assign-mapq","aliases":[],"type":"int","required":false,"required_when":[],"default":30,"conflicts":[],"description":"Minimum transcript-assignment MAPQ."},
    {"name":"--transcript-assign-chunk-size","aliases":[],"type":"int","required":false,"required_when":[],"default":200000,"conflicts":[],"description":"Transcript-assignment chunk size."},
    {"name":"--ref-interval","aliases":[],"type":"int","required":false,"required_when":[],"default":1000,"conflicts":[],"description":"Reference lookup interval."},
    {"name":"--feature-backend","aliases":[],"type":"string","required":false,"required_when":[],"default":"ont","choices":["ont","legacy"],"conflicts":[],"description":"Joint ONT-style assignment or legacy GTF overlap."},
    {"name":"--stringtie-opts","aliases":[],"type":"string","required":false,"required_when":[],"default":"-c 2","conflicts":[],"description":"Additional guided long-read assembly options."},
    {"name":"--ont-jobs","aliases":[],"type":"int","required":false,"required_when":[],"default":1,"conflicts":[],"description":"Concurrent chromosome jobs sharing cluster-threads."},
    {"name":"--ont-temp-dir","aliases":[],"type":"path","required":false,"required_when":[],"default":null,"conflicts":[],"description":"Scratch parent; defaults to system temp/TMPDIR."},
    {"name":"--cell-gene-max-reads","aliases":[],"type":"int","required":false,"required_when":[],"default":0,"conflicts":[],"description":"Per-cell gene read cap; 0 is unlimited in ONT mode, legacy defaults to 20000."},
    {"name":"--python","aliases":[],"type":"path","required":false,"required_when":[],"default":null,"conflicts":[],"description":"Python interpreter for every Python workflow stage."},
    {"name":"--help","aliases":["-h"],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Print command help."},
    {"name":"--version","aliases":["-V"],"type":"bool","required":false,"required_when":[],"default":false,"conflicts":[],"description":"Print Flora version."}
  ],
  "conditional_requirements": [
    "out-dir is always required",
    "gene-fasta, junction-bed, chrom-sizes, and gene-gtf must resolve explicitly or through ref-dir",
    "barcode-list-10bp must resolve explicitly or through bundled BC_1536.txt",
    "fastq is required unless skip-glycine is set",
    "full-length-fastq is required when skip-glycine is set",
    "isoform-gtf reuses gene-gtf when omitted"
  ],
  "resolution_rules": [
    "full-pipeline and upstream-only are accepted together; the last occurrence wins",
    "full-output and light-output are accepted together; the last occurrence wins",
    "explicit reference file options override files inferred from ref-dir"
  ],
  "interpreter": {"precedence":["--python","FLORA_PYTHON","python3"],"environment":"FLORA_PYTHON","fallback":"python3","scope":"all_python_stages"},
  "execution": {"stages":["glycine","reference_alignment","barcode_assignment","umi_assignment","cell_assignment","gene_assignment","isoform_assignment","qc","report"],"does_not_require":[]},
  "compatibility_exceptions": {"rejected_options":{"--glycine-bin-dir":"must_error_never_ignore","--whitelist-3p":"use_barcode-list-10bp","--whitelist-5p":"use_barcode-list-10bp"}},
  "invocations": {
    "accepted": [
      {"argv":["flora","--fastq","raw.fq.gz","--barcode-list-10bp","BC.txt","--ref-dir","ref","--out-dir","out"],"reason":"Minimal integrated workflow using inferred reference files."},
      {"argv":["flora","--skip-glycine","--full-length-fastq","full.fq.gz","--barcode_list_10bp","BC.txt","--gene-fasta","genome.fa","--junction-bed","genes.bed","--chrom-sizes","sizes.tsv","--gene-gtf","genes.gtf","--outdir","out","--python","/opt/python"],"reason":"Skip-Glycine path with legacy aliases, explicit references, and interpreter override."}
    ],
    "rejected": [
      {"argv":["flora","--fastq","raw.fq.gz","--ref-dir","ref","--out-dir","out","--glycine-bin-dir","bin"],"reason":"glycine-bin-dir is forbidden and must produce an unknown-option error.","violation":{"code":"unknown_option","option":"--glycine-bin-dir"}},
      {"argv":["flora","--skip-glycine","--ref-dir","ref","--out-dir","out"],"reason":"full-length-fastq is required when Glycine is skipped.","violation":{"code":"missing_conditional","option":"--full-length-fastq"}},
      {"argv":["flora","--fastq","raw.fq.gz","--out-dir","out"],"reason":"Reference inputs cannot be resolved.","violation":{"code":"missing_conditional","option":"--gene-fasta"}}
    ]
  }
}
